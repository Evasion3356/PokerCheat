<?xml version="1.0" encoding="utf-8"?>
<!--
  The poker advisor (hand reads, deck-ahead prediction, AI odds, HUD, bet
  hotkeys) as a static library, with no DllMain, menu, INI or log file of
  its own. Linked by PokerCheat.vcxproj (the standalone ASI) and by Rampagio,
  which pulls this repo in as a submodule and builds its option rows from
  Config::Options().

  The host provides: logging (src/PokerCheatLog.h sink), the option values
  (Config::Mutable; the ASI's Config.cpp reads the INI into it), keyboard
  state (keyboard.h's IsKeyDown/IsKeyJustUp/IsKeyWithAlt, defined by the
  host's own keyboard.cpp) and ScriptHookRDR2.lib. Calls natives through
  external/ScriptHookSDK's headers. Script thread only.
-->
<Project DefaultTargets="Build" ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="src\PokerCheat.cpp" />
    <ClCompile Include="src\PokerCheatConfig.cpp" />
    <ClCompile Include="src\PokerCheatLog.cpp" />
    <ClCompile Include="src\GamePointers.cpp" />
    <ClCompile Include="src\Localization.cpp" />
    <ClCompile Include="src\PatternScan.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="src\PokerCheat.h" />
    <ClInclude Include="src\PokerCheatLog.h" />
    <ClInclude Include="src\Config.h" />
    <ClInclude Include="src\ExtraNatives.h" />
    <ClInclude Include="src\GamePointers.h" />
    <ClInclude Include="src\HandRecord.h" />
    <ClInclude Include="src\Localization.h" />
    <ClInclude Include="src\PatternScan.h" />
    <ClInclude Include="src\PokerAiOdds.h" />
    <ClInclude Include="src\PokerHandEval.h" />
    <ClInclude Include="src\ScriptGlobal.h" />
    <ClInclude Include="src\ScriptLocal.h" />
  </ItemGroup>
  <PropertyGroup Label="Globals">
